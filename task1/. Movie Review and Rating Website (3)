<!DOCTYPE html>
<html>
<head>
    <title>Movie Review and Rating Website</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #111827;
            color: white;
        }

        header {
            background-color: #020617;
            padding: 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            color: #facc15;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 12px;
        }

        nav a:hover {
            color: #facc15;
        }

        .hero {
            text-align: center;
            padding: 70px 20px;
            background: linear-gradient(135deg, #7f1d1d, #111827);
        }

        .hero h2 {
            font-size: 40px;
            color: #facc15;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 18px;
            margin-bottom: 20px;
        }

        .btn {
            padding: 12px 25px;
            background-color: #facc15;
            color: black;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }

        .btn:hover {
            background-color: white;
        }

        .section {
            padding: 40px 25px;
        }

        .section h2 {
            text-align: center;
            color: #facc15;
            margin-bottom: 30px;
        }

        .movies {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .movie-card {
            background-color: #1e293b;
            border-radius: 12px;
            overflow: hidden;
            transition: 0.3s;
        }

        .movie-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 5px 20px #facc15;
        }

        .poster {
            height: 230px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 65px;
            background: linear-gradient(135deg, #7c2d12, #1e1b4b);
        }

        .poster.two {
            background: linear-gradient(135deg, #064e3b, #172554);
        }

        .poster.three {
            background: linear-gradient(135deg, #581c87, #1e293b);
        }

        .poster.four {
            background: linear-gradient(135deg, #1e3a8a, #7f1d1d);
        }

        .poster.five {
            background: linear-gradient(135deg, #713f12, #312e81);
        }

        .poster.six {
            background: linear-gradient(135deg, #831843, #1e293b);
        }

        .movie-info {
            padding: 20px;
        }

        .movie-info h3 {
            color: #facc15;
            margin-bottom: 12px;
        }

        .movie-info p {
            color: #cbd5e1;
            margin: 8px 0;
            line-height: 1.5;
        }

        .rating {
            color: #facc15;
            font-size: 18px;
            margin: 10px 0;
        }

        .reviews {
            background-color: #1e293b;
            padding: 22px;
            margin-bottom: 15px;
            border-left: 5px solid #facc15;
            border-radius: 8px;
        }

        .reviews h3 {
            color: #facc15;
            margin-bottom: 10px;
        }

        .reviews p {
            color: #cbd5e1;
            line-height: 1.6;
        }

        .details {
            background-color: #1e293b;
            padding: 25px;
            border-radius: 10px;
            line-height: 2;
        }

        footer {
            background-color: #020617;
            text-align: center;
            padding: 25px;
            color: #94a3b8;
        }

        @media (max-width: 768px) {
            header {
                flex-direction: column;
                gap: 15px;
            }

            nav {
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
            }

            .movies {
                grid-template-columns: repeat(2, 1fr);
            }

            .hero h2 {
                font-size: 30px;
            }
        }

        @media (max-width: 500px) {
            .movies {
                grid-template-columns: 1fr;
            }

            .section {
                padding: 30px 15px;
            }
        }
    </style>
</head>

<body>

<header>
    <h1>🎬 MovieZone</h1>

    <nav>
        <a href="#home">Home</a>
        <a href="#movies">Movies</a>
        <a href="#genres">Genres</a>
        <a href="#reviews">Reviews</a>
        <a href="#about">About</a>
    </nav>
</header>

