<!DOCTYPE html>
<html>
<head>
    <title>Business Analytics Dashboard</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f1f5f9;
        }

        .container {
            display: grid;
            grid-template-columns: 220px 1fr;
            min-height: 100vh;
        }

        .sidebar {
            background-color: #172554;
            color: white;
            padding: 25px;
        }

        .sidebar h2 {
            margin-bottom: 30px;
        }

        .sidebar ul {
            list-style: none;
        }

        .sidebar li {
            padding: 15px 5px;
            cursor: pointer;
        }

        .sidebar li:hover {
            background-color: #2563eb;
        }

        .main {
            padding: 25px;
            min-width: 0;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 25px;
        }

        .card {
            background-color: white;
            padding: 22px;
            border-radius: 10px;
            box-shadow: 0 2px 8px #ddd;
        }

        .card h3 {
            color: #64748b;
            margin-bottom: 12px;
        }

        .card h2 {
            color: #1e40af;
            font-size: 25px;
        }

        .positive {
            color: green;
            margin-top: 8px;
        }

        .charts {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
            margin-bottom: 25px;
        }

        .chart-box {
            background-color: white;
            padding: 20px;
            border-radius: 10px;
        }

        .chart-box h3 {
            margin-bottom: 20px;
        }

        .bars {
            display: flex;
            align-items: end;
            justify-content: space-around;
            height: 180px;
            border-bottom: 2px solid #ddd;
        }

        .bar {
            width: 35px;
            background-color: #3b82f6;
            border-radius: 5px 5px 0 0;
        }

        .bar:nth-child(even) {
            background-color: #22c55e;
        }

        .labels {
            display: flex;
            justify-content: space-around;
            margin-top: 10px;
        }

        .performance p {
            margin: 18px 0;
        }

        .progress {
            background-color: #e2e8f0;
            height: 10px;
            border-radius: 10px;
            margin-top: 8px;
        }

        .progress span {
            display: block;
            height: 10px;
            background-color: #2563eb;
            border-radius: 10px;
        }

        .table-box {
            background-color: white;
            padding: 20px;
            border-radius: 10px;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            min-width: 500px;
        }

        th, td {
            padding: 14px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        th {
            background-color: #dbeafe;
        }

        .status {
            color: green;
            font-weight: bold;
        }

        @media (max-width: 900px) {
            .cards {
                grid-template-columns: repeat(2, 1fr);
            }

            .charts {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 600px) {
            .container {
                grid-template-columns: 1fr;
            }

            .sidebar {
                padding: 15px;
            }

            .sidebar ul {
                display: flex;
                flex-wrap: wrap;
                gap: 5px;
            }

            .sidebar li {
                padding: 10px;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            .main {
                padding: 15px;
            }

            .header {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }
        }
    </style>
</head>

