<!DOCTYPE html>
<html>
<head>
    <title>Gaming and Esports Community</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #0f172a;
            color: white;
        }

        header {
            background-color: #020617;
            padding: 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            color: #38bdf8;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 12px;
        }

        nav a:hover {
            color: #38bdf8;
        }

        .hero {
            text-align: center;
            padding: 80px 20px;
            background: linear-gradient(135deg, #1e1b4b, #0f172a);
        }

        .hero h2 {
            font-size: 40px;
            color: #38bdf8;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 18px;
            margin-bottom: 25px;
        }

        .btn {
            background-color: #2563eb;
            color: white;
            padding: 12px 25px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }

        .btn:hover {
            background-color: #38bdf8;
            color: black;
        }

        .section {
            padding: 40px 25px;
        }

        .section h2 {
            color: #38bdf8;
            margin-bottom: 25px;
            text-align: center;
        }

        .games {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .card {
            background-color: #1e293b;
            padding: 22px;
            border-radius: 12px;
            text-align: center;
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 5px 20px #2563eb;
        }

        .card h3 {
            color: #38bdf8;
            margin-bottom: 12px;
        }

        .card p {
            line-height: 1.6;
            color: #cbd5e1;
        }

        .tournament {
            background-color: #1e293b;
            padding: 20px;
            margin-bottom: 15px;
            border-left: 5px solid #38bdf8;
            border-radius: 8px;
        }

        .tournament h3 {
            color: #38bdf8;
            margin-bottom: 10px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background-color: #1e293b;
        }

        th, td {
            padding: 15px;
            text-align: center;
            border-bottom: 1px solid #334155;
        }

        th {
            background-color: #2563eb;
        }

        tr:hover {
            background-color: #334155;
        }

        .news {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        footer {
            background-color: #020617;
            text-align: center;
            padding: 25px;
            margin-top: 30px;
            color: #94a3b8;
        }

        @media (max-width: 768px) {
            header {
                flex-direction: column;
                gap: 15px;
            }

            nav {
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
            }

            .games, .news {
                grid-template-columns: repeat(2, 1fr);
            }

            .hero h2 {
                font-size: 30px;
            }
        }

        @media (max-width: 500px) {
            .games, .news {
                grid-template-columns: 1fr;
            }

            .section {
                padding: 30px 15px;
            }

            table {
                font-size: 12px;
            }

            th, td {
                padding: 10px 5px;
            }
        }
    </style>
</head>

